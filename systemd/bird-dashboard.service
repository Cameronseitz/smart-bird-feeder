[Unit]
Description=Smart Bird Feeder Dashboard Flask
After=network.target bird-feeder.service

[Service]
User=pi
WorkingDirectory=/home/pi/bird-feeder-raspberry-pi
ExecStart=/home/pi/bird-feeder-raspberry-pi/venv/bin/python src/dashboard/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
